{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamFlow",
  "version": "0.1.0",
  "identifier": "com.streamflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "StreamFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "mpv-runtime/*": "mpv-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": ["native-libs/mpv-macos-runtime/libmpv.dylib"]
    },
    "linux": {
      "deb": {
        "depends": ["libmpv2"]
      },
      "rpm": {
        "depends": ["mpv-libs"]
      }
    }
  }
}
